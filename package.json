{
  "name": "@bill10/agent-007",
  "version": "0.6.5",
  "description": "From web terminals for your coding agents to a self-running agent company: Claude Code and Codex in parallel git worktrees, a job board they pick work from, and one agent that runs the board from a goal.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bill10/agent-007.git"
  },
  "homepage": "https://github.com/bill10/agent-007#readme",
  "type": "module",
  "main": "server.js",
  "bin": {
    "agent-007": "bin/agent-007.js"
  },
  "files": [
    ".env.example",
    "bin/",
    "lib/",
    "public/",
    "server/",
    "templates/",
    "server.js",
    "VERSION"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node bin/agent-007.js",
    "dev": "node --watch bin/agent-007.js",
    "adduser": "node bin/agent-007.js adduser",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "express": "^4.22.3",
    "node-pty": "^1.2.0-beta.12",
    "strip-ansi": "^7.1.0",
    "ws": "^8.18.0"
  },
  "bugs": {
    "url": "https://github.com/bill10/agent-007/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "coding-agents",
    "ai-agents",
    "agent-orchestration",
    "autonomous-agents",
    "parallel-agents",
    "git-worktree",
