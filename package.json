{
  "name": "@bill10/agent-007",
  "version": "0.6.2",
  "description": "Self-hosted office where a manager agent posts jobs to Claude Code and Codex workers in parallel git worktrees, then reviews and merges their PRs. Cron jobs, agent-to-agent messaging, pixel-art status view.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bill10/agent-007.git"
  },
  "homepage": "https://github.com/bill10/agent-007#readme",
  "type": "module",
  "main": "server.js",
  "bin": {
    "agent-007": "bin/agent-007.js"
  },
  "files": [
    "bin/",
    "lib/",
    "public/",
    "server/",
    "templates/",
    "server.js",
    "VERSION"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "adduser": "node --env-file-if-exists=.env bin/adduser.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "express": "^4.22.3",
    "node-pty": "^1.2.0-beta.12",
    "strip-ansi": "^7.1.0",
    "ws": "^8.18.0"
  },
  "bugs": {
    "url": "https://github.com/bill10/agent-007/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "coding-agents",
    "ai-agents",
    "agent-orchestration",
    "parallel-agents",
    "git-worktree",
    "job-board",
    "kanban",
    "pixel-art",
    "terminal",
    "self-hosted",
    "mcp"
  ]
}
